<svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="64" height="64" rx="16" fill="#0a0a0c"/>
  <g filter="url(#glow)">
    <rect x="8" y="8" width="48" height="48" rx="12" fill="none" stroke="#7f9cf5" stroke-width="2.5"/>
  </g>
  <text x="50%" y="54%" text-anchor="middle" fill="#fff" font-family="monospace" font-size="32" font-weight="bold" dy=".3em">S</text>
  <defs>
    <filter id="glow" x="0" y="0" width="64" height="64" filterUnits="userSpaceOnUse">
